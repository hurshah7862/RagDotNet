<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The packages `dotnet pack` just produced. run.ps1 fills this folder. -->
    <add key="local" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- RagDotNet packages come only from the local folder, never from nuget.org, so the smoke test always runs the build under test. -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="RagDotNet.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
