<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>PDF reader for RagDotNet: text blocks with page numbers, headings by font size, and warnings for pages and images with no extractable text.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RagDotNet.Core\RagDotNet.Core.csproj" />
  </ItemGroup>
</Project>
