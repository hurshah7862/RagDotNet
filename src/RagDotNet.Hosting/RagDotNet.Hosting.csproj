<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Background ingestion for RagDotNet: enqueue documents and check their status later. The default in-memory queue runs jobs on a hosted worker, with retries, cancel, and pause and resume; each job runs under the access scope of the caller that enqueued it.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RagDotNet.Hosting.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RagDotNet.Core\RagDotNet.Core.csproj" />
  </ItemGroup>
</Project>
