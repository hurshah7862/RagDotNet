<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Tesseract OCR provider for RagDotNet: reads scanned PDF pages and images embedded in PDF, DOCX and HTML. Windows binaries are included; Linux and macOS use the system Tesseract (apt install tesseract-ocr, brew install tesseract). Language data is not included.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- PrivateAssets="none": TesseractOCR copies its Windows libraries into the app's x64/ and x86/ folders through
         build/TesseractOCR.targets. The default (build assets private) would stop that targets file reaching apps that
         install this package, and Windows OCR would fail with "Failed to find library 'leptonica-1.85.0.dll'". -->
    <PackageReference Include="TesseractOCR" PrivateAssets="none" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RagDotNet.Ocr.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RagDotNet.Core\RagDotNet.Core.csproj" />
    <ProjectReference Include="..\RagDotNet.Readers.Pdf.Rendering\RagDotNet.Readers.Pdf.Rendering.csproj" />
  </ItemGroup>
</Project>
