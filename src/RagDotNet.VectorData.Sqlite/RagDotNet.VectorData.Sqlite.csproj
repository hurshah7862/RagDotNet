<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>SQLite vector store for RagDotNet: a Microsoft.Extensions.VectorData connector on SQLite with sqlite-vec, with exact vector search and FTS5 hybrid search. sqlite-vec is included for win-x64, linux-x64 and osx-arm64.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- VectorData.Abstractions asks for an AI.Abstractions version that is not on NuGet; pin the one Core uses. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RagDotNet.VectorData.Sqlite.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    sqlite-vec natives: downloaded from the pinned GitHub release at build time (not committed), checked against pinned
    SHA-256 hashes, and shipped under runtimes/<rid>/native/. A hash mismatch fails the build.
  -->
  <PropertyGroup>
    <SqliteVecVersion>0.1.9</SqliteVecVersion>
    <SqliteVecDir>$(MSBuildProjectDirectory)/natives/$(SqliteVecVersion)/</SqliteVecDir>
  </PropertyGroup>
  <ItemGroup>
    <SqliteVecNative Include="linux-x64" Archive="sqlite-vec-$(SqliteVecVersion)-loadable-linux-x86_64.tar.gz" NativeFile="vec0.so" Sha256="b959baa1d8dc88861b1edb337b8587178cdcb12d60b4998f9d10b6a82052d5d7" />
    <SqliteVecNative Include="osx-arm64" Archive="sqlite-vec-$(SqliteVecVersion)-loadable-macos-aarch64.tar.gz" NativeFile="vec0.dylib" Sha256="8282126333399ddfe98bbbcc7a1936e7252625aac49df056a98be602e46bfd29" />
    <SqliteVecNative Include="win-x64" Archive="sqlite-vec-$(SqliteVecVersion)-loadable-windows-x86_64.tar.gz" NativeFile="vec0.dll" Sha256="51581189d52066b4dfc6631f6d7a3eab7dedc2260656ab09ca97ab3fb8165983" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="natives/$(SqliteVecVersion)/linux-x64/vec0.so" Link="runtimes/linux-x64/native/vec0.so" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <Content Include="natives/$(SqliteVecVersion)/osx-arm64/vec0.dylib" Link="runtimes/osx-arm64/native/vec0.dylib" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <Content Include="natives/$(SqliteVecVersion)/win-x64/vec0.dll" Link="runtimes/win-x64/native/vec0.dll" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>

  <!-- Every build (each target framework, and pack) asks for the fetch through one MSBuild call with the same global
       properties; MSBuild runs a target once per such call in a build, so parallel target frameworks never race. -->
  <Target Name="FetchSqliteVecNatives" BeforeTargets="BeforeBuild;GetCopyToOutputDirectoryItems;_GetPackageFiles">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_FetchSqliteVecNativesOnce" RemoveProperties="TargetFramework;RuntimeIdentifier" />
  </Target>

  <!-- Batched per native and skipped when the file is already there. -->
  <Target Name="_FetchSqliteVecNativesOnce"
          Inputs="$(MSBuildProjectFullPath)" Outputs="$(SqliteVecDir)%(SqliteVecNative.Identity)/%(SqliteVecNative.NativeFile)">
    <PropertyGroup>
      <_VecScratch>$(SqliteVecDir)tmp-$([System.Guid]::NewGuid().ToString('N'))/</_VecScratch>
    </PropertyGroup>
    <DownloadFile SourceUrl="https://github.com/asg017/sqlite-vec/releases/download/v$(SqliteVecVersion)/%(SqliteVecNative.Archive)"
                  DestinationFolder="$(_VecScratch)" DestinationFileName="%(SqliteVecNative.Archive)" Retries="3" />
    <GetFileHash Files="$(_VecScratch)%(SqliteVecNative.Archive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_VecHash" />
    </GetFileHash>
    <Error Condition="'$(_VecHash)' != '%(SqliteVecNative.Sha256)'"
           Text="sqlite-vec download %(SqliteVecNative.Archive) failed its hash check: expected %(SqliteVecNative.Sha256), got $(_VecHash)." />
    <Exec Command="tar -xzf &quot;%(SqliteVecNative.Archive)&quot;" WorkingDirectory="$(_VecScratch)" />
    <Copy SourceFiles="$(_VecScratch)%(SqliteVecNative.NativeFile)" DestinationFolder="$(SqliteVecDir)%(SqliteVecNative.Identity)" Retries="5" RetryDelayMilliseconds="200" />
    <RemoveDir Directories="$(_VecScratch)" ContinueOnError="true" />
  </Target>
</Project>
