<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>PDF page rendering for RagDotNet OCR: renders scanned PDF pages to images so an OCR provider can read them. Uses PDFtoImage (PDFium), with native libraries for Windows, Linux and macOS.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFtoImage" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RagDotNet.Core\RagDotNet.Core.csproj" />
  </ItemGroup>
</Project>
